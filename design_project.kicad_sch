	(text "Switch\n"
		(exclude_from_sim no)
		(at 130.302 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0b6945ef-975b-427d-8cf7-aa0291f67a72")
	)
	(text "We designed the charging circuit using the BQ24075 with jumpers\nfor switching between 200mA and 600mA charging modes.\nThe circuit connects to a 9V input source and a LiPo battery,\nwith resistors to set the charge and input current limits.\nCapacitors are included for stability\nand an LED indicate charging "
		(exclude_from_sim no)
		(at 61.976 139.192 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1216203c-7df1-499d-a865-f507fe1b8e9e")
	)
	(text "Motor Driver"
		(exclude_from_sim no)
		(at 33.528 17.526 0)
		(effects
			(font
				(size 3.81 3.81)
			)
		)
		(uuid "8321798e-73de-4495-8d7b-03b54d8b9c0b")
	)
	(text "high-end switching\n"
		(exclude_from_sim no)
		(at 210.058 15.748 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9ec47739-8df5-4412-9434-77dea3a27ebd")
	)
	(text "2x DRV8833 (H-Bridge motor drivers) are used to provide bidirection.\n control to the motors.\nThe PWM & control lines from MCU control the speed of the motor.\nA capacitor is used to stabilize power and reduce noise."
		(exclude_from_sim no)
		(at 51.816 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a45fabd8-f9b2-41af-98cd-b2d12e598b59")
	)
